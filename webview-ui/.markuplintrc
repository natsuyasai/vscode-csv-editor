{
  "extends": [
    "markuplint:recommended-react"
  ],
  "excludeFiles": [
    "./node_modules/**/*",
    "./src/**/*.stories.tsx",
    "./src/**/*.spec.tsx"
  ],
  "parser": {
    ".tsx$": "@markuplint/jsx-parser"
  },
  "specs": {
    ".tsx$": "@markuplint/react-spec"
  },
  "nodeRules": [
    {
      "selector": "div[role=button]",
      "rules": {
        "no-unknown-attr": {
          "options": {
            "allowAttrs": [
              "onDoubleClick"
            ]
          }
        }
      }
    },
    {
      "selector": "td[role=gridcell], th[scope=col]",
      "rules": {
        "no-unknown-attr": {
          "options": {
            "allowAttrs": [
              "onDoubleClick"
            ]
          }
        }
      }
    }
  ],
  "overrides": {
    "./**/editable-table/EditableTable.tsx": {
      "rules": {
        "permitted-contents": false,
        "a11y/table-row-column-alignment": false,
        "a11y/no-empty-table-track": false,
        "a11y/wai-aria/required-owned-elements": false
      }
    },
    "./**/table-cell/EditableCell.tsx": {
      "rules": {
        "a11y/wai-aria/presentational-children": false
      }
    }
  },
  "rules": {
    "security/no-event-handler-attr": false
  },
  "overrideMode": "merge"
}
