{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "types": [
      "vitest/globals"
    ],
    "composite": true,
    "rootDir": "..",
    "outDir": "./dist/test"
  },
  "include": [
    "__mocks__/**/*",
    "./src/**/*",
    "../src/message/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "src/**/*.stories.*",
    "src/test-utils/appStoryUtils.ts",
    "src/test-utils/rowSizeSelect.ts"
  ]
}