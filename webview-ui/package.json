{
  "name": "webview-ui",
  "version": "0.0.2-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "build:debug:watch": "tsc && vite build --sourcemap \"inline\" --minify false --mode \"development\" --watch",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --project unit",
    "test:story": "vitest --project storybook",
    "test:property": "vitest --project unit --run property.spec",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,css}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check-types": "tsc --build",
    "lint": "eslint ./ && npm run markuplint",
    "markuplint": "markuplint \"./src/**/*.{jsx,tsx}\"",
    "postinstall": "node scripts/copyicon.cjs"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.22",
    "@vscode-elements/react-elements": "^2.4.0",
    "@vscode/codicons": "^0.0.43",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@markuplint/jsx-parser": "^4.18.4",
    "@markuplint/react-spec": "^4.18.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "markuplint": "^4.18.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
