{
  "name": "csv-editor",
  "displayName": "csv-editor",
  "description": "Edit CSV files in a spreadsheet-like table editor with sorting, filtering, undo/redo, and copy/paste.",
  "version": "0.0.1",
  "license": "MIT",
  "keywords": [
    "csv",
    "editor",
    "table",
    "spreadsheet",
    "tsv",
    "excel",
    "data"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/natsuyasai/vscode-csv-editor"
  },
  "homepage": "https://github.com/natsuyasai/vscode-csv-editor#readme",
  "bugs": {
    "url": "https://github.com/natsuyasai/vscode-csv-editor/issues"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "publisher": "natsuyasai",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Data Science"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "csv-editor.openEditor",
        "displayName": "CSV Editor",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.CSV"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "csv-editor.largeEditor",
        "displayName": "CSV Editor (Large File)",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.CSV"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "csv-editor.openEditor",
        "title": "Open CSV Editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "csv-editor.openEditor",
          "when": "resourceExtname =~ /^\\.[cC][sS][vV]$/ && activeCustomEditorId != csv-editor.openEditor && activeCustomEditorId != csv-editor.largeEditor",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run build:webview && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src && node scripts/check-feature-sync.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test": "vscode-test",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
}
